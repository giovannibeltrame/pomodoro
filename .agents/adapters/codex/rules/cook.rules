# cook:begin io.github.lmarqs.cookbook:agents#connect/commands
# io.github.lmarqs.cookbook:agents#connect --harness=claude --harness=codex --worktree-setup=.worktrees/setup --worktree-teardown=.worktrees/teardown
# bypass: refuse reaches Claude only: --ignore-rules or an untrusted project skips these rules, --approve-for-me approves prompts
prefix_rule(pattern = ["git", ["status", "diff", "log", "show", "fetch", "add", "commit", "switch", "push"]], decision = "allow")
prefix_rule(pattern = ["git", "worktree", ["list", "add"]], decision = "allow")
prefix_rule(pattern = ["gh", "pr", ["view", "list", "diff", "checks", "create", "edit"]], decision = "allow")
prefix_rule(pattern = ["npm", "ci"], decision = "allow")
prefix_rule(pattern = ["npm", "test"], decision = "allow")
prefix_rule(pattern = ["npm", "run", ["lint", "build", "test"]], decision = "allow")
prefix_rule(pattern = ["npx", "vitest", "run"], decision = "allow")
prefix_rule(pattern = ["mise", "exec", "--", "npm", ["ci", "test"]], decision = "allow")
prefix_rule(pattern = ["mise", "exec", "--", "npm", "run", ["lint", "build", "test"]], decision = "allow")
prefix_rule(pattern = ["mise", "exec", "--", "cook", ["check", "help", "--dry-run"]], decision = "allow")
prefix_rule(pattern = ["scripts/ralph-check"], decision = "allow")
prefix_rule(pattern = ["python3", "-m", "json.tool"], decision = "allow")
prefix_rule(pattern = ["sh", ".agents/skills/agents-layout/scripts/check.sh"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "prompt")
prefix_rule(pattern = ["npm", "install"], decision = "prompt")
prefix_rule(pattern = ["git", "push", ["--force", "-f"]], decision = "forbidden")
# Not enforced by Codex, Claude-only: git push * --force*
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden")
# cook:end io.github.lmarqs.cookbook:agents#connect/commands
